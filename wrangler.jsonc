{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-portal-v2",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "muslim101.rafis.my.id",
      "custom_domain": true
    }
  ]
}
